{
  "name": "c64-tech-tree",
  "version": "1.0.0",
  "private": true,
  "description": "A production-process tree tracing the Commodore 64 back to raw materials through early-1980s industry.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs && node scripts/serve.mjs",
    "serve": "node scripts/serve.mjs",
    "start:classic": "node scripts/build.mjs && node scripts/serve.mjs --classic",
    "serve:classic": "node scripts/serve.mjs --classic",
    "test": "node scripts/selftest.mjs"
  }
}